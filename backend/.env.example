# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=roadread

# CORS Settings (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Computer Vision & Survey Defaults
ROADREAD_DEFAULT_ROAD_WIDTH_M=7.0
ROADREAD_SURVEY_SPEED_KMH=25

# Optional: Path to custom YOLO road damage model weights
# ROAD_DAMAGE_MODEL_PATH=models/road_damage/yolov8s_rdd2022.pt

# Optional: External LLM API Keys for live streaming brief
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
